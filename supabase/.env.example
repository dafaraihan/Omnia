# Copy the values into Supabase project secrets; do not commit a real .env file.
# The app receives only SUPABASE_URL and its publishable key.
TMDB_READ_ACCESS_TOKEN=replace-with-tmdb-read-access-token
TVDB_API_KEY=replace-with-tvdb-v4-api-key
# Optional: required only for TVDB user-supported access.
TVDB_SUBSCRIBER_PIN=
# Random operational secret for the protected discovery seed/status/reindex calls.
# Generate with: openssl rand -hex 32
METADATA_SEED_TOKEN=replace-with-random-64-character-hex-token
