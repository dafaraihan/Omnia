// Copy to Config/Secrets.xcconfig (git ignores it) and fill in Omnia's own
// app credentials. Never commit the filled-in file.
//
// Trakt:   https://trakt.tv/oauth/applications — Production app; any https
//          redirect URI (device sign-in doesn't use it). Client ID + Secret.
// Simkl:   https://simkl.com/settings/developer — Client ID.
// MDBList: https://mdblist.com — OAuth client with device authorization.
//          Client ID.
// AniList: https://anilist.co/settings/developer — redirect URL
//          omnia://anilist. Client ID (a number).
//
// Values are plain text after `=`, with no quotes.

OMNIA_TRAKT_CLIENT_ID =
OMNIA_TRAKT_CLIENT_SECRET =
OMNIA_SIMKL_CLIENT_ID =
OMNIA_MDBLIST_CLIENT_ID =
OMNIA_ANILIST_CLIENT_ID =
