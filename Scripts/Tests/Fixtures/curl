#!/bin/bash
set -euo pipefail

output=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --output|-o)
            output="${2:-}"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

[[ -n "$output" && -f "${OMNIA_TEST_ARCHIVE:-}" ]] || exit 64
cp "$OMNIA_TEST_ARCHIVE" "$output"
